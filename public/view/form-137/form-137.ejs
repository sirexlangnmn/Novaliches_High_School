
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>SF10-JHS Form 137</title>
    <style>
        @page { size: A4 portrait; margin: 8mm; }
        .no-print { text-align: center; margin-bottom: 10px; }
        .no-print button { padding: 10px 24px; font-size: 14px; cursor: pointer; background: #2563eb; color: #fff; border: none; border-radius: 6px; }
        .no-print button:hover { background: #1d4ed8; }
        @media print {
            .no-print { display: none !important; }
            body { padding: 0 !important; margin: 0 !important; }
            body, td, th { font-size: 9px !important; }
            table { margin-top: 1px !important; }
            td, th { padding: 1px 2px !important; }
            [style*="width:90px"] { width: 45px !important; }
            [style*="width:140px"] { width: 65px !important; }
            [style*="font-size:38px"] { font-size: 12px !important; line-height: 14px !important; }
            [style*="font-size:20px"] { font-size: 10px !important; }
            [style*="font-size:18px"] { font-size: 9px !important; }
            [style*="margin-top:10px"] { margin-top: 1px !important; }
            [style*="margin-top:8px"] { margin-top: 1px !important; }
            [style*="margin-top:4px"] { margin-top: 0 !important; }
            [style*="line-height:40px"] { line-height: 14px !important; }
            [style*="height:22px"] { height: 6px !important; }
            [style*="height:35px"] { height: 10px !important; padding: 0 2px !important; }
            [style*="width:18px"][style*="height:18px"] { width: 8px !important; height: 8px !important; }
            [style*="padding:6px 0 6px 20px"] { padding: 0 0 0 8px !important; }
        }
    </style>
</head>
<body style="font-family: Arial, sans-serif; margin:0; padding:10px; font-size:12px; color:#000;">

<div class="no-print">
    <button onclick="window.print()">Download as PDF</button>
</div>

<table style="width:100%; border-collapse:collapse;">
    <tr>
        <td style="width:15%; vertical-align:top;">
            <img src="{{deped_logo_left}}" style="width:90px; height:auto;">
        </td>

        <td style="width:70%; text-align:center; vertical-align:middle;">
            <div style="font-size:18px;">Republic of the Philippines</div>
            <div style="font-size:20px; margin-top:2px;">Department of Education</div>
            <div style="font-size:38px; font-weight:bold; margin-top:8px; line-height:40px;">
                Learner's Permanent Academic Record for Junior High School (SF10-JHS)
            </div>
            <div style="font-size:18px; font-style:italic; margin-top:4px;">
                (Formerly Form 137)
            </div>
        </td>

        <td style="width:15%; text-align:right; vertical-align:top;">
            <img src="{{deped_logo_right}}" style="width:140px; height:auto;">
        </td>
    </tr>
</table>

<!-- LEARNER INFORMATION -->
<table style="width:100%; border-collapse:collapse; margin-top:10px;">
    <tr>
        <td colspan="12" style="background:#d8d2bc; text-align:center; font-weight:bold; font-size:18px; padding:6px; border:1px solid #000;">
            LEARNER'S INFORMATION
        </td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px; width:12%;">LAST NAME:</td>
        <td style="border:1px solid #000; padding:6px; width:20%;">{{last_name}}</td>

        <td style="border:1px solid #000; padding:6px; width:12%;">FIRST NAME:</td>
        <td style="border:1px solid #000; padding:6px; width:20%;">{{first_name}}</td>

        <td style="border:1px solid #000; padding:6px; width:10%;">NAME EXTN:</td>
        <td style="border:1px solid #000; padding:6px; width:8%;">{{name_extension}}</td>

        <td style="border:1px solid #000; padding:6px; width:10%;">MIDDLE NAME:</td>
        <td style="border:1px solid #000; padding:6px; width:18%;">{{middle_name}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">LRN:</td>
        <td colspan="3" style="border:1px solid #000; padding:6px;">{{lrn}}</td>

        <td style="border:1px solid #000; padding:6px;">Birthdate:</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">{{birthdate}}</td>

        <td style="border:1px solid #000; padding:6px;">Sex:</td>
        <td style="border:1px solid #000; padding:6px;">{{sex}}</td>
    </tr>
</table>

<!-- ELIGIBILITY -->
<table style="width:100%; border-collapse:collapse; margin-top:10px;">
    <tr>
        <td colspan="8" style="background:#d8d2bc; text-align:center; font-weight:bold; font-size:18px; padding:6px; border:1px solid #000;">
            ELIGIBILITY FOR JHS ENROLLMENT
        </td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px; width:5%; text-align:center;">
            <div style="width:18px; height:18px; border:1px solid #000; margin:auto;"></div>
        </td>
        <td style="border:1px solid #000; padding:6px; width:25%;">Elementary School Completer</td>
        <td style="border:1px solid #000; padding:6px; width:15%;">General Average:</td>
        <td style="border:1px solid #000; padding:6px; width:10%;">{{general_average}}</td>
        <td style="border:1px solid #000; padding:6px; width:10%;">Citation:</td>
        <td colspan="3" style="border:1px solid #000; padding:6px;">{{citation}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;"></td>
        <td style="border:1px solid #000; padding:6px;">Name of Elementary School:</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">{{elementary_school}}</td>
        <td style="border:1px solid #000; padding:6px;">School ID:</td>
        <td style="border:1px solid #000; padding:6px;">{{school_id}}</td>
        <td style="border:1px solid #000; padding:6px;">Address:</td>
        <td style="border:1px solid #000; padding:6px;">{{school_address}}</td>
    </tr>

    <tr>
        <td colspan="8" style="border:1px solid #000; padding:6px; font-weight:bold;">
            Other Credential Presented
        </td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px; text-align:center;">
            <div style="width:18px; height:18px; border:1px solid #000; margin:auto;"></div>
        </td>
        <td style="border:1px solid #000; padding:6px;">PEPT Passer</td>
        <td style="border:1px solid #000; padding:6px;">Rating:</td>
        <td style="border:1px solid #000; padding:6px;">{{pept_rating}}</td>

        <td style="border:1px solid #000; padding:6px; text-align:center;">
            <div style="width:18px; height:18px; border:1px solid #000; margin:auto;"></div>
        </td>
        <td style="border:1px solid #000; padding:6px;">ALS A & E Passer</td>
        <td style="border:1px solid #000; padding:6px;">Rating:</td>
        <td style="border:1px solid #000; padding:6px;">{{als_rating}}</td>
    </tr>

    <tr>
        <td colspan="2" style="border:1px solid #000; padding:6px;">Date of Examination:</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">{{exam_date}}</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">Testing Center:</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">{{testing_center}}</td>
    </tr>
</table>

<!-- SCHOLASTIC RECORD -->
<table style="width:100%; border-collapse:collapse; margin-top:10px;">
    <tr>
        <td colspan="11" style="background:#d8d2bc; text-align:center; font-weight:bold; font-size:18px; padding:6px; border:1px solid #000;">
            SCHOLASTIC RECORD
        </td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">School:</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">{{school_name}}</td>
        <td style="border:1px solid #000; padding:6px;">School ID:</td>
        <td style="border:1px solid #000; padding:6px;">{{school_id_2}}</td>
        <td style="border:1px solid #000; padding:6px;">District:</td>
        <td style="border:1px solid #000; padding:6px;">{{district}}</td>
        <td style="border:1px solid #000; padding:6px;">Division:</td>
        <td style="border:1px solid #000; padding:6px;">{{division}}</td>
        <td style="border:1px solid #000; padding:6px;">Region:</td>
        <td style="border:1px solid #000; padding:6px;">{{region}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">Classified as Grade:</td>
        <td style="border:1px solid #000; padding:6px;">{{grade_level}}</td>
        <td style="border:1px solid #000; padding:6px;">Section:</td>
        <td style="border:1px solid #000; padding:6px;">{{section}}</td>
        <td style="border:1px solid #000; padding:6px;">School Year:</td>
        <td style="border:1px solid #000; padding:6px;">{{school_year}}</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">Adviser/Teacher:</td>
        <td colspan="2" style="border:1px solid #000; padding:6px;">{{adviser}}</td>
        <td style="border:1px solid #000; padding:6px;">{{signature}}</td>
    </tr>
</table>

<!-- GRADES TABLE -->
<table style="width:100%; border-collapse:collapse; margin-top:0; table-layout:fixed;">
    <tr>
        <th rowspan="2" style="border:1px solid #000; padding:6px; width:35%; background:#efefef;">LEARNING AREAS</th>
        <th colspan="4" style="border:1px solid #000; padding:6px; background:#efefef;">Quarterly Rating</th>
        <th rowspan="2" style="border:1px solid #000; padding:6px; width:10%; background:#efefef;">FINAL RATING</th>
        <th rowspan="2" style="border:1px solid #000; padding:6px; width:15%; background:#efefef;">REMARKS</th>
    </tr>

    <tr>
        <th style="border:1px solid #000; padding:6px; width:5%; background:#efefef;">1</th>
        <th style="border:1px solid #000; padding:6px; width:5%; background:#efefef;">2</th>
        <th style="border:1px solid #000; padding:6px; width:5%; background:#efefef;">3</th>
        <th style="border:1px solid #000; padding:6px; width:5%; background:#efefef;">4</th>
    </tr>

    <!-- SUBJECT ROWS -->
    <tr>
        <td style="border:1px solid #000; padding:6px;">Filipino</td>
        <td style="border:1px solid #000;">{{fil_q1}}</td>
        <td style="border:1px solid #000;">{{fil_q2}}</td>
        <td style="border:1px solid #000;">{{fil_q3}}</td>
        <td style="border:1px solid #000;">{{fil_q4}}</td>
        <td style="border:1px solid #000;">{{fil_final}}</td>
        <td style="border:1px solid #000;">{{fil_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">English</td>
        <td style="border:1px solid #000;">{{eng_q1}}</td>
        <td style="border:1px solid #000;">{{eng_q2}}</td>
        <td style="border:1px solid #000;">{{eng_q3}}</td>
        <td style="border:1px solid #000;">{{eng_q4}}</td>
        <td style="border:1px solid #000;">{{eng_final}}</td>
        <td style="border:1px solid #000;">{{eng_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">Mathematics</td>
        <td style="border:1px solid #000;">{{math_q1}}</td>
        <td style="border:1px solid #000;">{{math_q2}}</td>
        <td style="border:1px solid #000;">{{math_q3}}</td>
        <td style="border:1px solid #000;">{{math_q4}}</td>
        <td style="border:1px solid #000;">{{math_final}}</td>
        <td style="border:1px solid #000;">{{math_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">Science</td>
        <td style="border:1px solid #000;">{{science_q1}}</td>
        <td style="border:1px solid #000;">{{science_q2}}</td>
        <td style="border:1px solid #000;">{{science_q3}}</td>
        <td style="border:1px solid #000;">{{science_q4}}</td>
        <td style="border:1px solid #000;">{{science_final}}</td>
        <td style="border:1px solid #000;">{{science_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">Araling Panlipunan (AP)</td>
        <td style="border:1px solid #000;">{{ap_q1}}</td>
        <td style="border:1px solid #000;">{{ap_q2}}</td>
        <td style="border:1px solid #000;">{{ap_q3}}</td>
        <td style="border:1px solid #000;">{{ap_q4}}</td>
        <td style="border:1px solid #000;">{{ap_final}}</td>
        <td style="border:1px solid #000;">{{ap_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">Edukasyon sa Pagpapakatao (EsP)</td>
        <td style="border:1px solid #000;">{{esp_q1}}</td>
        <td style="border:1px solid #000;">{{esp_q2}}</td>
        <td style="border:1px solid #000;">{{esp_q3}}</td>
        <td style="border:1px solid #000;">{{esp_q4}}</td>
        <td style="border:1px solid #000;">{{esp_final}}</td>
        <td style="border:1px solid #000;">{{esp_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">Technology and Livelihood Education (TLE)</td>
        <td style="border:1px solid #000;">{{tle_q1}}</td>
        <td style="border:1px solid #000;">{{tle_q2}}</td>
        <td style="border:1px solid #000;">{{tle_q3}}</td>
        <td style="border:1px solid #000;">{{tle_q4}}</td>
        <td style="border:1px solid #000;">{{tle_final}}</td>
        <td style="border:1px solid #000;">{{tle_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px;">MAPEH</td>
        <td style="border:1px solid #000;">{{mapeh_q1}}</td>
        <td style="border:1px solid #000;">{{mapeh_q2}}</td>
        <td style="border:1px solid #000;">{{mapeh_q3}}</td>
        <td style="border:1px solid #000;">{{mapeh_q4}}</td>
        <td style="border:1px solid #000;">{{mapeh_final}}</td>
        <td style="border:1px solid #000;">{{mapeh_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px 0 6px 20px;">Music</td>
        <td style="border:1px solid #000;">{{music_q1}}</td>
        <td style="border:1px solid #000;">{{music_q2}}</td>
        <td style="border:1px solid #000;">{{music_q3}}</td>
        <td style="border:1px solid #000;">{{music_q4}}</td>
        <td style="border:1px solid #000;">{{music_final}}</td>
        <td style="border:1px solid #000;">{{music_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px 0 6px 20px;">Arts</td>
        <td style="border:1px solid #000;">{{arts_q1}}</td>
        <td style="border:1px solid #000;">{{arts_q2}}</td>
        <td style="border:1px solid #000;">{{arts_q3}}</td>
        <td style="border:1px solid #000;">{{arts_q4}}</td>
        <td style="border:1px solid #000;">{{arts_final}}</td>
        <td style="border:1px solid #000;">{{arts_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px 0 6px 20px;">Physical Education</td>
        <td style="border:1px solid #000;">{{physical_education_q1}}</td>
        <td style="border:1px solid #000;">{{physical_education_q2}}</td>
        <td style="border:1px solid #000;">{{physical_education_q3}}</td>
        <td style="border:1px solid #000;">{{physical_education_q4}}</td>
        <td style="border:1px solid #000;">{{physical_education_final}}</td>
        <td style="border:1px solid #000;">{{physical_education_remarks}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; padding:6px 0 6px 20px;">Health</td>
        <td style="border:1px solid #000;">{{health_q1}}</td>
        <td style="border:1px solid #000;">{{health_q2}}</td>
        <td style="border:1px solid #000;">{{health_q3}}</td>
        <td style="border:1px solid #000;">{{health_q4}}</td>
        <td style="border:1px solid #000;">{{health_final}}</td>
        <td style="border:1px solid #000;">{{health_remarks}}</td>
    </tr>

    <!-- EXTRA EMPTY ROWS -->
    <tr><td style="border:1px solid #000; height:22px;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td></tr>
    <tr><td style="border:1px solid #000; height:22px;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td><td style="border:1px solid #000;"></td></tr>

    <tr>
        <td colspan="5" style="border:1px solid #000; padding:6px; text-align:right; font-weight:bold; font-style:italic;">
            General Average
        </td>
        <td style="border:1px solid #000; padding:6px;">{{overall_average}}</td>
        <td style="border:1px solid #000; padding:6px;">{{overall_remarks}}</td>
    </tr>
</table>

<!-- REMEDIAL CLASSES -->
<table style="width:100%; border-collapse:collapse; margin-top:0;">
    <tr>
        <td style="border:1px solid #000; padding:6px; width:20%; text-align:center; font-weight:bold;">
            Remedial Classes
        </td>

        <td colspan="4" style="border:1px solid #000; padding:6px; font-weight:bold;">
            Conducted from (mm/dd/yyyy) {{remedial_from}} to (mm/dd/yyyy) {{remedial_to}}
        </td>
    </tr>

    <tr>
        <th style="border:1px solid #000; padding:6px; background:#efefef;">Learning Areas</th>
        <th style="border:1px solid #000; padding:6px; background:#efefef;">Final Rating</th>
        <th style="border:1px solid #000; padding:6px; background:#efefef;">Remedial Class Mark</th>
        <th style="border:1px solid #000; padding:6px; background:#efefef;">Recomputed Final Grade</th>
        <th style="border:1px solid #000; padding:6px; background:#efefef;">Remarks</th>
    </tr>

    <tr>
        <td style="border:1px solid #000; height:35px; padding:6px;">{{remedial_subject_1}}</td>
        <td style="border:1px solid #000; padding:6px;">{{remedial_final_rating_1}}</td>
        <td style="border:1px solid #000; padding:6px;">{{remedial_mark_1}}</td>
        <td style="border:1px solid #000; padding:6px;">{{recomputed_grade_1}}</td>
        <td style="border:1px solid #000; padding:6px;">{{remedial_remarks_1}}</td>
    </tr>

    <tr>
        <td style="border:1px solid #000; height:35px; padding:6px;">{{remedial_subject_2}}</td>
        <td style="border:1px solid #000; padding:6px;">{{remedial_final_rating_2}}</td>
        <td style="border:1px solid #000; padding:6px;">{{remedial_mark_2}}</td>
        <td style="border:1px solid #000; padding:6px;">{{recomputed_grade_2}}</td>
        <td style="border:1px solid #000; padding:6px;">{{remedial_remarks_2}}</td>
    </tr>
</table>

<!-- SIGNATURES -->
<table style="width:100%; border-collapse:collapse; margin-top:20px;">
    <tr>
        <td style="width:50%; text-align:center; padding:6px;">
            <div style="margin-top:30px; border-top:1px solid #000; display:inline-block; padding:0 40px;">
                {{adviser}}
            </div>
            <div style="font-weight:bold;">Adviser</div>
            <div style="font-size:10px;">(Signature over Printed Name)</div>
        </td>
        <td style="width:50%; text-align:center; padding:6px;">
            <div style="margin-top:30px; border-top:1px solid #000; display:inline-block; padding:0 40px;">
                {{principal_signature}}
            </div>
            <div style="font-weight:bold;">Principal</div>
            <div style="font-size:10px;">(Signature over Printed Name)</div>
        </td>
    </tr>
    <tr>
        <td style="text-align:center; padding:6px;"></td>
        <td style="text-align:center; padding:6px;">
            <div style="margin-top:10px; border-top:1px solid #000; display:inline-block; padding:0 40px;">
                {{school_head_signature}}
            </div>
            <div style="font-weight:bold;">School Head</div>
            <div style="font-size:10px;">(Signature over Printed Name)</div>
        </td>
    </tr>
</table>

</body>
<script>
    (function() {
        var data = null;
        try {
            data = JSON.parse(localStorage.getItem('form137Data'));
        } catch(e) {}
        if (data) {
            document.body.innerHTML = document.body.innerHTML.replace(/\{\{(\w+)\}\}/g, function(match, key) {
                return data[key] !== undefined && data[key] !== null ? data[key] : '';
            });
        }
    })();
</script>
</html>
