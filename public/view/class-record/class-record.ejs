            const gradeFieldCategory = {
                'written-1': 'writtenScores', 'written-2': 'writtenScores', 'written-3': 'writtenScores',
                'written-4': 'writtenScores', 'written-5': 'writtenScores',
                'perf-1': 'performanceScores', 'perf-2': 'performanceScores', 'perf-3': 'performanceScores',
                'exam-st1': 'examScores', 'exam-st2': 'examScores', 'exam-te': 'examScores'
            };
            const gradeCategoryFields = {
                'writtenScores': ['written-1','written-2','written-3','written-4','written-5'],
                'performanceScores': ['perf-1','perf-2','perf-3'],
                'examScores': ['exam-st1','exam-st2','exam-te']
            };
            const highestPossibleScores = {
                'written-1': 10, 'written-2': 10, 'written-3': 10, 'written-4': 10, 'written-5': 10,
                'perf-1': 25, 'perf-2': 25, 'perf-3': 25,
                'exam-st1': 40, 'exam-st2': 40, 'exam-te': 50
            };
            function validateGradeInput(inputEl) {
                const field = inputEl.dataset.field;
                const max = highestPossibleScores[field];
                if (max === undefined) return true;

                inputEl.value = inputEl.value.replace(/\D/g, '');

                const val = inputEl.value;
                if (val === '') return true;

                const num = parseInt(val, 10);
                if (isNaN(num) || num < 0 || num > max) {
                    console.log(`Invalid input for ${field}: "${val}". Must be between 0 and ${max}.`);
                    inputEl.value = inputEl.dataset.lastValidValue || '';
                    return false;
                }

                inputEl.dataset.lastValidValue = val;
                return true;
            }

            function createStudentRow(student, index) {
                const row = document.createElement('tr');
                const sid = student.id;
