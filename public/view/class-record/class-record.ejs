            function recomputeStudent(studentId) {
                const getVal = (field) => {
                    const el = document.querySelector(`input[data-student-id="${studentId}"][data-field="${field}"]`);
                    const v = el ? parseFloat(el.value) : 0;
                    return isNaN(v) ? 0 : v;
                };
                const setCell = (field, value) => {
                    const cell = document.querySelector(`td[data-student-id="${studentId}"][data-field="${field}"]`);
                    if (cell) {
                        const num = parseFloat(value);
                        cell.textContent = isNaN(num) ? '' : (Number.isInteger(num) ? num : num.toFixed(2));
                    }
                };

                const wTotal = getVal('written-1')+getVal('written-2')+getVal('written-3')+getVal('written-4')+getVal('written-5');
                const wPS = (wTotal / 50) * 100;
                const wWS = wPS * 0.20;
                setCell('written-total', wTotal);
                setCell('written-ps', wPS);
                setCell('written-ws', wWS);

                const pTotal = getVal('perf-1')+getVal('perf-2')+getVal('perf-3');
                const pPS = (pTotal / 75) * 100;
                const pWS = pPS * 0.50;
                setCell('perf-total', pTotal);
                setCell('perf-ps', pPS);
                setCell('perf-ws', pWS);

                const eTotal = getVal('exam-st1')+getVal('exam-st2')+getVal('exam-te');
                const ePS = (eTotal / 130) * 100;
                const eWS = ePS * 0.30;
                setCell('exam-total', eTotal);
                setCell('exam-ps', ePS);
                setCell('exam-ws', eWS);

                const initialGrade = wWS + pWS + eWS;
                setCell('initial-grade', initialGrade);

                const termGrade = Math.round(initialGrade);
                const termCell = document.querySelector(`td[data-student-id="${studentId}"][data-field="term-grade"]`);
                if (termCell) {
                    termCell.textContent = termGrade;
                    termCell.style.color = termGrade < 75 ? 'red' : '';
                }

                let descriptor = 'Beginning';
                if (termGrade >= 90) descriptor = 'Advanced';
                else if (termGrade >= 85) descriptor = 'Proficient';
                else if (termGrade >= 80) descriptor = 'Approaching Proficiency';
                else if (termGrade >= 75) descriptor = 'Developing';

                const descCell = document.querySelector(`td[data-student-id="${studentId}"][data-field="descriptor"]`);
                if (descCell) {
                    descCell.textContent = descriptor;
                    descCell.style.color = termGrade < 75 ? 'red' : '';
                }
            }

            function onGradeChange(studentId, inputEl) {
                const field = inputEl.dataset.field;
                const category = gradeFieldCategory[field] || field;
                let originalValues, updatedValues;

                if (gradeCategoryFields[category]) {
                    originalValues = JSON.parse(inputEl.dataset.originalValues || '[]');
                    updatedValues = gradeCategoryFields[category].map(f => {
                        const el = document.querySelector(`input[data-student-id="${studentId}"][data-field="${f}"]`);
                        return el ? parseFloat(el.value) || 0 : 0;
                    });
                } else {
                    originalValues = inputEl.dataset.originalValue || '';
                    updatedValues = inputEl.value;
                }

                const studentData = collectStudentData(studentId);

                const studentFromData = studentsData.students.find(s => s.id === studentId);
                const subjectData = studentFromData?.subjects?.[currentSubjectName] || {};
                const teacherName = document.getElementById('teacher-name').textContent;
                const quarterText = document.getElementById('quarter-display').dataset.quarter;

                const changeRecord = {
                    student_id: studentId,
                    field: category,
                    previous_value: originalValues,
                    updated_value: updatedValues
                };

                const referenceData = {
                    learner_school_record_id: studentFromData?.learnerSchoolRecordId || null,
                    quarter: quarterText,
                    teacher: teacherName,
                    learning_area: currentSubjectName
                };

                console.log('Grade Change Record:', JSON.stringify(changeRecord, null, 2));
                console.log('Reference Data:', JSON.stringify(referenceData, null, 2));
                const fullRecord = {
                    id: studentId,
                    name: studentData.name,
                    subjects: {
                        [currentSubjectName]: {
                            teacher: teacherName,
                            writtenScores: studentData.writtenScores,
                            writtenTotal: studentData.writtenTotal,
                            writtenPS: studentData.writtenPS,
                            writtenWS: studentData.writtenWS,
                            performanceScores: studentData.performanceScores,
                            performanceTotal: studentData.performanceTotal,
                            performancePS: studentData.performancePS,
                            performanceWS: studentData.performanceWS,
                            examScores: studentData.examScores,
                            examTotal: studentData.examTotal,
                            examPS: studentData.examPS,
                            examWS: studentData.examWS,
                            initialGrade: studentData.initialGrade,
                            termGrade: studentData.termGrade,
                            descriptor: studentData.descriptor
                        }
                    }
                };
                console.log('Updated Student Record:', JSON.stringify(fullRecord, null, 2));

                sendGradeChangeData(changeRecord, fullRecord, referenceData);
            }

            function sendGradeChangeData(gradeChangeRecord, updatedStudentRecord, referenceData) {
                fetch('/api/save/class-record/grade-change', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gradeChangeRecord, updatedStudentRecord, referenceData }),
                })
                .then(res => res.json())
                .then(data => console.log('Grade change saved:', data))
                .catch(err => console.error('Error saving grade change:', err));
            }

            function collectStudentData(studentId) {
                const row = document.querySelector(`#student-rows tr input[data-student-id="${studentId}"]`)?.closest('tr');
                if (!row) return null;
                const nameCell = row.querySelector('td.student-name');
                const name = nameCell ? nameCell.textContent.replace(/^\d+\.\s*/, '').trim() : '';

                const getInput = (field) => {
                    const el = row.querySelector(`input[data-field="${field}"]`);
                    const v = el ? parseFloat(el.value) : 0;
                    return isNaN(v) ? 0 : v;
                };
                const getCell = (field) => {
                    const el = row.querySelector(`td[data-field="${field}"]`);
                    const v = el ? parseFloat(el.textContent) : 0;
                    return isNaN(v) ? 0 : v;
                };

                return {
                    id: studentId,
                    name,
                    subject: currentSubjectName,
                    writtenScores: [getInput('written-1'), getInput('written-2'), getInput('written-3'), getInput('written-4'), getInput('written-5')],
                    writtenTotal: getCell('written-total'),
                    writtenPS: getCell('written-ps'),
                    writtenWS: getCell('written-ws'),
                    performanceScores: [getInput('perf-1'), getInput('perf-2'), getInput('perf-3')],
                    performanceTotal: getCell('perf-total'),
                    performancePS: getCell('perf-ps'),
                    performanceWS: getCell('perf-ws'),
                    examScores: [getInput('exam-st1'), getInput('exam-st2'), getInput('exam-te')],
                    examTotal: getCell('exam-total'),
                    examPS: getCell('exam-ps'),
                    examWS: getCell('exam-ws'),
                    initialGrade: getCell('initial-grade'),
                    termGrade: getCell('term-grade'),
                    descriptor: (row.querySelector('td[data-field="descriptor"]') || {}).textContent || ''
                };
            }

            function loadLearningAreas() {
                fetch('/api/get/learning-areas/all', { method: 'POST' })
                    .then(res => res.json())
                    .then(areas => {
                        const select = document.getElementById('learning-areas');
                        select.innerHTML = '<option value="">Select Learning Area</option>';
                        areas.forEach(area => {
                            const opt = document.createElement('option');
                            opt.value = area.code;
                            opt.textContent = area.name;
                            select.appendChild(opt);
                        });
                    })
                    .catch(err => console.error('Error loading learning areas:', err));
            }

            function fetchClassRecords(code, name, quarterId) {
                currentSubjectName = name;
                fetch('/api/get/class-records/by-learning-area', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ learningAreaCode: code, quarterId: quarterId }),
                })
                .then(response => response.json())
                .then(data => {
                    studentsData = { students: data.students };

                    document.getElementById('school-name').textContent = data.school || '';
                    document.getElementById('division-name').textContent = data.division || '';
                    document.getElementById('school-year').textContent = data.schoolYear || '';
                    const quarterLabels = { 1: '1st Quarter', 2: '2nd Quarter', 3: '3rd Quarter', 4: '4th Quarter' };
                    document.getElementById('quarter-label').textContent = quarterLabels[data.quarter] || '';
                    document.getElementById('quarter-display').dataset.quarter = data.quarter;
                    document.getElementById('grade-section').textContent = data.gradeLevel && data.section ? `${data.gradeLevel} - ${data.section}` : '';

                    const firstStudent = data.students[0];
                    if (firstStudent && firstStudent.subjects && firstStudent.subjects[name]) {
                        document.getElementById('teacher-name').textContent = firstStudent.subjects[name].teacher;
                    }
                    populateTable();
                })
                .catch(error => console.error('Error loading data:', error));
            }

            document.getElementById('select-quarter').addEventListener('change', function() {
                const laSelect = document.getElementById('learning-areas');
                laSelect.selectedIndex = 0;
                document.getElementById('student-rows').innerHTML = '';
                document.getElementById('teacher-name').textContent = '';
            });

            document.getElementById('learning-areas').addEventListener('change', function() {
                const quarterId = document.getElementById('select-quarter').value;
                if (!quarterId) {
                    alert('Please select a quarter first.');
                    this.selectedIndex = 0;
                    return;
                }
                const opt = this.options[this.selectedIndex];
                if (opt && opt.value) {
                    fetchClassRecords(opt.value, opt.textContent, quarterId);
                } else {
                    document.getElementById('student-rows').innerHTML = '';
                    document.getElementById('teacher-name').textContent = '';
                }
            });

            loadLearningAreas();

            function populateTable() {
                const tbody = document.getElementById('student-rows');
                tbody.innerHTML = '';
                studentsData.students.forEach((student, index) => {
                    const row = createStudentRow(student, index);
                    tbody.appendChild(row);
                });
            }

        </script>

</body>

</html>