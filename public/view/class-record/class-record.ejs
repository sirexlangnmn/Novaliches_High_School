                nameCell.style.border = '1px solid #000';
                nameCell.style.textAlign = 'left';
                nameCell.style.paddingLeft = '10px';
                nameCell.style.cursor = 'pointer';
                nameCell.title = 'Click to view Form-137';
                nameCell.id = `student-name-${sid}`;
                nameCell.textContent = `${index + 1}. ${student.name}`;
                nameCell.addEventListener('click', () => {
                    console.log('learner_school_record_id:', student.learnerSchoolRecordId);
                    const studentData = collectStudentData(sid);
                    studentData.subject = currentSubjectName;
                    localStorage.setItem('selectedStudent', JSON.stringify(studentData));
                    fetch('/api/get/student/form-137-data', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ learnerSchoolRecordId: student.learnerSchoolRecordId }),
                    })
                    .then(res => res.json())
                    .then(data => {
                        console.log('form-137 response:', data);
                        localStorage.setItem('form137Data', JSON.stringify(data));
                        window.open('/form-137-ui', '_blank');
                    })
                    .catch(err => console.error('Error fetching form-137 data:', err));
                });
                row.appendChild(nameCell);

                const writtenFields = ['written-1','written-2','written-3','written-4','written-5'];
                const writtenScores = subj.writtenScores || [];
                for (let i = 0; i < 5; i++) {
                    const cell = document.createElement('td');
                    cell.className = 'input-cell';
                    cell.style.border = '1px solid #000';
                    cell.style.padding = '0';
                    cell.style.width = '45px';
                    cell.style.height = '35px';

                    const input = document.createElement('input');
                    input.type = 'text';
                    input.inputMode = 'numeric';
                    input.maxLength = '3';
                    input.value = writtenScores[i] || '';
                    input.style.width = '45px';
                    input.style.height = '35px';
                    input.style.border = 'none';
                    input.style.textAlign = 'center';
                    input.style.fontSize = '16px';
                    input.style.outline = 'none';
                    input.style.background = 'transparent';
                    input.style.padding = '0';
                    input.style.margin = '0';
                    input.id = `input-${sid}-${writtenFields[i]}`;
                    input.dataset.studentId = sid;
                    input.dataset.field = writtenFields[i];
                    input.addEventListener('focus', function() {
                        const cat = gradeFieldCategory[this.dataset.field];
                        if (cat && gradeCategoryFields[cat]) {
                            this.dataset.originalValues = JSON.stringify(gradeCategoryFields[cat].map(f => {
                                const el = document.querySelector(`input[data-student-id="${sid}"][data-field="${f}"]`);
                                return el ? parseFloat(el.value) || 0 : 0;
                            }));
                        }
                    });
                    input.addEventListener('input', function() {
                        if (validateGradeInput(this)) {
                            recomputeStudent(sid);
                        }
                    });
                    input.addEventListener('blur', function() {
                        if (this.value.trim() === '') {
                            this.value = '0';
                        }
                        const cat = gradeFieldCategory[this.dataset.field];
                        const stored = this.dataset.originalValues;
                        if (cat && stored) {
                            const oldVals = JSON.parse(stored);
                            const newVals = gradeCategoryFields[cat].map(f => {
                                const el = document.querySelector(`input[data-student-id="${sid}"][data-field="${f}"]`);
                                return el ? parseFloat(el.value) || 0 : 0;
                            });
                            if (JSON.stringify(oldVals) !== JSON.stringify(newVals)) {
                                recomputeStudent(sid);
                                onGradeChange(sid, this);
                            }
                        }
