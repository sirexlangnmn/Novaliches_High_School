                    cell.className = 'input-cell';
                    cell.style.border = '1px solid #000';
                    cell.style.padding = '0';
                    cell.style.width = '45px';
                    cell.style.height = '35px';

                    const input = document.createElement('input');
                    input.type = 'text';
                    input.inputMode = 'numeric';
                    input.maxLength = '3';
                    input.value = perfScores[i] || '';
                    input.style.width = '45px';
                    input.style.height = '35px';
                    input.style.border = 'none';
                    input.style.textAlign = 'center';
                    input.style.fontSize = '16px';
                    input.style.outline = 'none';
                    input.style.background = 'transparent';
                    input.style.padding = '0';
                    input.style.margin = '0';
                    input.id = `input-${sid}-${perfFields[i]}`;
                    input.dataset.studentId = sid;
                    input.dataset.field = perfFields[i];
                    input.addEventListener('focus', function() {
                        const cat = gradeFieldCategory[this.dataset.field];
                        if (cat && gradeCategoryFields[cat]) {
                            this.dataset.originalValues = JSON.stringify(gradeCategoryFields[cat].map(f => {
                                const el = document.querySelector(`input[data-student-id="${sid}"][data-field="${f}"]`);
                                return el ? parseFloat(el.value) || 0 : 0;
                            }));
                        }
                    });
                    input.addEventListener('input', function() {
                        if (validateGradeInput(this)) {
                            recomputeStudent(sid);
                        }
                    });
                    input.addEventListener('blur', function() {
                        if (this.value.trim() === '') {
                            this.value = '0';
                        }
                        const cat = gradeFieldCategory[this.dataset.field];
                        const stored = this.dataset.originalValues;
                        if (cat && stored) {
                            const oldVals = JSON.parse(stored);
                            const newVals = gradeCategoryFields[cat].map(f => {
                                const el = document.querySelector(`input[data-student-id="${sid}"][data-field="${f}"]`);
                                return el ? parseFloat(el.value) || 0 : 0;
                            });
                            if (JSON.stringify(oldVals) !== JSON.stringify(newVals)) {
                                recomputeStudent(sid);
                                onGradeChange(sid, this);
                            }
                        }
                    });

                    cell.appendChild(input);
                    row.appendChild(cell);
                }

                const perfMeta = ['perf-total','perf-ps','perf-ws'];
                [subj.performanceTotal, subj.performancePS, subj.performanceWS].forEach((value, i) => {
                    const cell = document.createElement('td');
                    cell.id = `cell-${sid}-${perfMeta[i]}`;
                    cell.style.border = '1px solid #000';
                    cell.textContent = value || '';
                    cell.style.fontSize = '16px';
                    cell.dataset.studentId = sid;
                    cell.dataset.field = perfMeta[i];
                    row.appendChild(cell);
                });

                const examFields = ['exam-st1','exam-st2','exam-te'];
                const examScores = subj.examScores || [];
                for (let i = 0; i < 3; i++) {
                    const cell = document.createElement('td');
                    cell.className = 'input-cell';
                    cell.style.border = '1px solid #000';
                    cell.style.padding = '0';
                    cell.style.width = '45px';
                    cell.style.height = '35px';

                    const input = document.createElement('input');
                    input.type = 'text';
                    input.inputMode = 'numeric';
                    input.maxLength = '3';
                    input.value = examScores[i] || '';
                    input.style.width = '45px';
                    input.style.height = '35px';
                    input.style.border = 'none';
                    input.style.textAlign = 'center';
                    input.style.fontSize = '16px';
                    input.style.outline = 'none';
                    input.style.background = 'transparent';
                    input.style.padding = '0';
                    input.style.margin = '0';
                    input.id = `input-${sid}-${examFields[i]}`;
                    input.dataset.studentId = sid;
                    input.dataset.field = examFields[i];
                    input.addEventListener('focus', function() {
                        const cat = gradeFieldCategory[this.dataset.field];
                        if (cat && gradeCategoryFields[cat]) {
                            this.dataset.originalValues = JSON.stringify(gradeCategoryFields[cat].map(f => {
                                const el = document.querySelector(`input[data-student-id="${sid}"][data-field="${f}"]`);
                                return el ? parseFloat(el.value) || 0 : 0;
                            }));
                        }
                    });
                    input.addEventListener('input', function() {
                        if (validateGradeInput(this)) {
                            recomputeStudent(sid);
                        }
                    });
                    input.addEventListener('blur', function() {
                        if (this.value.trim() === '') {
                            this.value = '0';
                        }
                        const cat = gradeFieldCategory[this.dataset.field];
                        const stored = this.dataset.originalValues;
                        if (cat && stored) {
                            const oldVals = JSON.parse(stored);
                            const newVals = gradeCategoryFields[cat].map(f => {
                                const el = document.querySelector(`input[data-student-id="${sid}"][data-field="${f}"]`);
                                return el ? parseFloat(el.value) || 0 : 0;
                            });
                            if (JSON.stringify(oldVals) !== JSON.stringify(newVals)) {
                                recomputeStudent(sid);
